{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperbolica.invalid/schemas/differential-fixture.json",
  "title": "Hyperbolica differential fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "compare", "request"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "compare": {
      "enum": ["byte", "normalized", "semantic"]
    },
    "request": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"type": "string", "minLength": 1},
        "schema_version_min": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "ignore": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "ignore_recursive": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reason": {"type": "string", "minLength": 1},
    "semantic_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "permutation_field": {"type": "string", "minLength": 1},
    "permutation_values": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "dependentRequired": {
    "permutation_field": ["permutation_values"],
    "permutation_values": ["permutation_field"]
  },
  "oneOf": [
    {
      "properties": {"compare": {"const": "byte"}},
      "not": {
        "anyOf": [
          {"required": ["ignore"]},
          {"required": ["ignore_recursive"]},
          {"required": ["reason"]},
          {"required": ["semantic_fields"]},
          {"required": ["permutation_field"]},
          {"required": ["permutation_values"]}
        ]
      }
    },
    {
      "required": ["ignore", "reason"],
      "properties": {"compare": {"const": "normalized"}},
      "not": {"required": ["semantic_fields"]}
    },
    {
      "required": ["reason", "semantic_fields"],
      "properties": {
        "compare": {"const": "semantic"},
        "request": {
          "required": ["op", "vars"],
          "properties": {
            "vars": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {"required": ["permutation_field"]},
          {"required": ["permutation_values"]}
        ]
      }
    }
  ]
}
