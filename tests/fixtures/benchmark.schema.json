{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperbolica.invalid/schemas/benchmark-fixture.json",
  "title": "Hyperbolica benchmark fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "request"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "request": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"type": "string", "minLength": 1},
        "schema_version_min": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    }
  }
}
