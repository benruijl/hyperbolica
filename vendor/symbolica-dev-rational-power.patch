+        rational::Q,
+        rational_polynomial::{RationalPolynomial, RationalPolynomialField},
+    },
     parse,
     parser::{ParseSettings, Token},
     poly::{PolyVariable, polynomial::MultivariatePolynomial},
     symbol,
