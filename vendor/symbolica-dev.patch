+///
+/// Implementations own the projection to the elimination variable and the
+/// representation- and domain-specific algorithm choice, just as
+/// [`PolynomialGCD`] owns multivariate GCD selection. The default uses the
+/// generic Lazard-Ducos recurrence; domains that need a different plan opt in
+/// explicitly instead of relying on overlapping blanket implementations.
+/// In particular, there is intentionally no blanket implementation for all
+/// fields: on stable Rust it would overlap coefficient-domain overrides such
+/// as the rational integer-associate/CRT selector.
+pub trait PolynomialResultant<E: PositiveExponent>: EuclideanDomain + PolynomialGCD<E> {
+    fn resultant(
+        left: &MultivariatePolynomial<Self, E>,
+        right: &MultivariatePolynomial<Self, E>,
+        variable: usize,
+    ) -> MultivariatePolynomial<Self, E>
+    where
+        Self: Sized,
+    {
+        left.to_univariate(variable)
+            .resultant(&right.to_univariate(variable))
+    }
+}
