+//! Run with no argument (grow) or `shrink`. Uses only pre-fix APIs.
+use std::sync::Arc;
+use symbolica::prelude::*;
+
+fn main() {
+    let variables = Arc::new(vec![PolyVariable::from(symbol!("x"))]);
+    let shrink = std::env::args().nth(1).as_deref() == Some("shrink");
+    let (source, target) = if shrink {
+        (Some(variables), Vec::new())
+    } else {
+        (None, variables.as_ref().clone())
+    };
+    // Both operations are valid: constants do not depend on any variable.
+    for expression in ["0", "7", "-7/3"] {
+        let polynomial = parse!(expression).to_polynomial::<_, u16>(&Q, source.clone());
+        println!(
+            "rearrange {expression}: {:?} -> {target:?}",
+            polynomial.variables()
+        );
+        let result = polynomial.rearrange_with_growth(&target).unwrap();
+        assert_eq!(result.variables().as_ref(), &target);
+        assert_eq!(result.get_constant(), polynomial.get_constant());
+    }
+}
diff --git a/examples/mre_factored_construction.rs b/examples/mre_factored_construction.rs
new file mode 100644
index 0000000..a6072ee
--- /dev/null
+++ b/examples/mre_factored_construction.rs
@@ -0,0 +1,203 @@
+//! Minimal factored-rational construction regressions using only APIs from
+//! Symbolica revision 0b57776. No new materialization API is required.
+//!
+//! Run one case with:
+//! `cargo run --example mre_factored_construction -- powered_cancellation`
+//! Use `--list` for case names or `all` to run every case on a patched build.
+//! Each case prints its name before asserting its exact expected behavior.
+
+use symbolica::domains::EuclideanDomain;
+use symbolica::domains::factorized_rational_polynomial::FromNumeratorAndFactorizedDenominator;
+use symbolica::domains::rational_polynomial::FromNumeratorAndDenominator;
+use symbolica::poly::gcd::PolynomialGCD;
+use symbolica::prelude::*;
+
+const CASES: &[&str] = &[
+    "powered_cancellation",
+    "negative_sign",
+    "rational_scaling",
+    "finite_field_units",
+    "algebraic_units",
+    "zero_denominator",
+    "zero_power",
+    "duplicate_arithmetic",
+];
+
+fn atom(text: &str) -> Atom {
+    Atom::parse(text, "mre_factored_construction", ParseSettings::default()).unwrap()
+}
+
+// Materialize explicitly through the original public fields and the existing
+// canonical rational-polynomial constructor. This keeps the reproducer usable
+// on revisions that do not have FactorizedRationalPolynomial::to_rational_polynomial.
+fn materialize<R>(value: FactorizedRationalPolynomial<R, u16>) -> RationalPolynomial<R, u16>
+where
+    R: EuclideanDomain + PolynomialGCD<u16>,
+    RationalPolynomial<R, u16>: FromNumeratorAndDenominator<R, R, u16>,
+{
+    let numerator = value.numerator.mul_coeff(value.numer_coeff);
+    let denominator = value.denominators.into_iter().fold(
+        numerator.constant(value.denom_coeff),
+        |product, (base, power)| product * &base.pow(power),
+    );
+    let ring = numerator.ring().clone();
+    RationalPolynomial::from_num_den(numerator, denominator, &ring, true)
+}
+
+fn assert_value<R>(
+    actual: FactorizedRationalPolynomial<R, u16>,
+    expected: RationalPolynomial<R, u16>,
+) where
+    R: EuclideanDomain + PolynomialGCD<u16>,
+    RationalPolynomial<R, u16>: FromNumeratorAndDenominator<R, R, u16>,
+{
+    let actual = materialize(actual);
+    eprintln!("  actual: {actual}\n  expected: {expected}");
+    assert_eq!(actual, expected);
+}
+
+fn powered_cancellation() {
+    // v/v^2 = 1/v, not 1. Cancelling one gcd from the base must not
+    // cancel that gcd to the entire denominator multiplicity.
+    let v = atom("x+1").to_polynomial::<_, u16>(&Z, None);
+    let expected = RationalPolynomial::from_num_den(v.clone(), v.pow(2), &Z, true);
+    let actual = FactorizedRationalPolynomial::from_num_den(v.clone(), vec![(v, 2)], &Z, true);
+    assert_value(actual, expected);
+}
+
+fn negative_sign() {
+    // 1/(-v)^2 = 1/v^2: the scalar sign depends on exponent parity.
+    let v = atom("x+1").to_polynomial::<_, u16>(&Z, None);
+    let expected = RationalPolynomial::from_num_den(v.one(), v.pow(2), &Z, true);
+    let actual = FactorizedRationalPolynomial::from_num_den(v.one(), vec![(-v, 2)], &Z, false);
+    assert_value(actual, expected);
+}
+
+fn rational_scaling() {
+    // (1/2)/((x+1)/2)^2 = 2/(x+1)^2. A common content cannot be
+    // removed once from every powered base without compensating its power.
+    let numerator = atom("1/2").to_polynomial::<_, u16>(&Q, None);
+    let base = atom("(x+1)/2").to_polynomial::<_, u16>(&Q, None);
+    let expected = RationalPolynomial::from_num_den(numerator.clone(), base.pow(2), &Z, true);
+    let actual = FactorizedRationalPolynomial::from_num_den(numerator, vec![(base, 2)], &Z, true);
+    assert_value(actual, expected);
+}
+
+fn finite_field_units() {
+    // In F_17, 1/(3v)^2 = 2/v^2, not 6/v^2.
+    let field = Zp::new(17);
+    let base = atom("3*x+3").to_polynomial::<_, u16>(&field, None);
+    let expected = RationalPolynomial::from_num_den(base.one(), base.pow(2), &field, true);
+    let actual =
+        FactorizedRationalPolynomial::from_num_den(base.one(), vec![(base, 2)], &field, false);
+    assert_value(actual, expected);
+}
+
+fn algebraic_units() {
+    // For a^2=2, 1/(a*v)^2 = 1/(2*v^2), not a/(2*v^2).
+    let field = AlgebraicExtension::new(atom("a^2-2").to_polynomial::<_, u16>(&Q, None));
+    let base = atom("x+1")
+        .to_polynomial::<_, u16>(&field, None)
+        .mul_coeff(field.generator());
+    let expected = RationalPolynomial::from_num_den(base.one(), base.pow(2), &field, true);
+    let actual =
+        FactorizedRationalPolynomial::from_num_den(base.one(), vec![(base, 2)], &field, false);
+    assert_value(actual, expected);
+}
+
+fn zero_denominator() {
+    // A zero denominator must be rejected, including when factoring is
+    // enabled. The original Z path can silently discard the zero factor.
+    let zero = atom("0").to_polynomial::<_, u16>(&Z, None);
+    for do_factor in [false, true] {
+        eprintln!("  denominator=0^2, do_factor={do_factor}: expecting rejection");
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            FactorizedRationalPolynomial::from_num_den(
+                zero.one(),
+                vec![(zero.clone(), 2)],
+                &Z,
+                do_factor,
+            )
+        }));
+        assert!(
+            result.is_err(),
+            "a positive power of a zero denominator was accepted"
+        );
+    }
+}
+
+fn zero_power() {
+    // A supplied base with exponent zero contributes one. In particular,
+    // normalizing 0^0 must not index the zero polynomial's empty coefficient list.
+    let field = Zp::new(17);
+    let zero = atom("0").to_polynomial::<_, u16>(&field, None);
+    let expected = RationalPolynomial::from_num_den(zero.one(), zero.one(), &field, true);
+    let actual =
+        FactorizedRationalPolynomial::from_num_den(zero.one(), vec![(zero, 0)], &field, false);
+    assert_value(actual, expected);
+}
+
+fn duplicate_arithmetic(operation: Option<&str>) {
+    // a=1/(v*v), b=1/v. Disabling factorization must still merge identical
+    // supplied bases; arithmetic aligns exponents by the first occurrence.
+    let v = atom("x+1").to_polynomial::<_, u16>(&Z, None);
+    let a = FactorizedRationalPolynomial::from_num_den(
+        v.one(),
+        vec![(v.clone(), 1), (v.clone(), 1)],
+        &Z,
+        false,
+    );
+    let b = FactorizedRationalPolynomial::from_num_den(v.one(), vec![(v.clone(), 1)], &Z, false);
+    let a_value = RationalPolynomial::from_num_den(v.one(), v.pow(2), &Z, true);
+    let b_value = RationalPolynomial::from_num_den(v.one(), v.clone(), &Z, true);
+    for name in ["duplicate_add", "duplicate_mul", "duplicate_div"] {
+        if operation.is_some_and(|selected| selected != name) {
+            continue;
+        }
+        eprintln!("  operation: {name}");
+        match name {
+            "duplicate_add" => assert_value(&a + &b, &a_value + &b_value),
+            "duplicate_mul" => assert_value(&a * &b, &a_value * &b_value),
+            "duplicate_div" => assert_value(&a / &b, &a_value / &b_value),
+            _ => unreachable!(),
+        }
+    }
+}
+
+fn run(name: &str) {
+    eprintln!("case: {name}");
+    match name {
+        "powered_cancellation" => powered_cancellation(),
+        "negative_sign" => negative_sign(),
+        "rational_scaling" => rational_scaling(),
+        "finite_field_units" => finite_field_units(),
+        "algebraic_units" => algebraic_units(),
+        "zero_denominator" => zero_denominator(),
+        "zero_power" => zero_power(),
+        "duplicate_arithmetic" => duplicate_arithmetic(None),
+        "duplicate_add" | "duplicate_mul" | "duplicate_div" => duplicate_arithmetic(Some(name)),
+        _ => {
+            eprintln!("unknown case; use --list");
+            std::process::exit(2);
+        }
+    }
+    eprintln!("PASS: {name}");
+}
+
+fn main() {
+    let selected = std::env::args().nth(1).unwrap_or_else(|| "all".into());
+    match selected.as_str() {
+        "--list" | "--help" => {
+            println!(
+                "{}\nduplicate_add\nduplicate_mul\nduplicate_div",
+                CASES.join("\n")
+            );
+        }
+        "all" => {
+            for name in CASES {
+                run(name);
+            }
+        }
+        name => run(name),
+    }
+}
diff --git a/examples/mre_galois_upgrade.rs b/examples/mre_galois_upgrade.rs
new file mode 100644
index 0000000..fab39a3
--- /dev/null
+++ b/examples/mre_galois_upgrade.rs
@@ -0,0 +1,47 @@
+//! Bounded reproducer for an intermittent finite-field factorization panic.
+//!
+//! Run a debug build, with `SYMBOLICA_LICENSE` inherited from the environment:
+//! `cargo run --example mre_galois_upgrade -- 100`
+//!
+//! The input is fixed, but factorization uses randomized choices. Some attempts
+//! panic in `quot_rem_univariate_monic`: a divisor over an algebraic extension
+//! has leading coefficient different from one. A passing run does not disprove
+//! the bug; rerun this command to obtain independent fresh-process attempts.
+//! The example deliberately does not catch the panic, preserving its backtrace.
+//! It uses only existing public APIs and can also be copied to older revisions.
+
+use symbolica::prelude::*;
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let attempts = args
+        .next()
+        .map(|arg| arg.parse::<usize>().expect("attempts must be an integer"))
+        .unwrap_or(100);
+    assert!(attempts > 0, "attempts must be positive");
+    assert!(
+        args.next().is_none(),
+        "usage: mre_galois_upgrade [attempts]"
+    );
+
+    let polynomial =
+        parse!("x^7(y^5+y^4+y^3+y^2)+x^5(y^3+y)+x^4(y^4+y)+x^3(y^2+y)+x^2y+x*y^2+x*y+x+y+1")
+            .to_polynomial::<_, u8>(&Z2, None);
+
+    for attempt in 1..=attempts {
+        eprintln!("factorization attempt {attempt}/{attempts}");
+        let factors = polynomial.factor();
+        let mut reconstructed = polynomial.one();
+        for (factor, multiplicity) in &factors {
+            reconstructed = reconstructed * &factor.pow(*multiplicity);
+        }
+        let mut expected = polynomial.clone();
+        reconstructed.unify_variables(&mut expected);
+        assert_eq!(reconstructed, expected, "reconstruction, attempt {attempt}");
+        assert_eq!(factors.len(), 2, "factor count, attempt {attempt}");
+    }
+
+    println!(
+        "All {attempts} attempts reconstructed exactly with two factors; no failure observed."
+    );
+}
