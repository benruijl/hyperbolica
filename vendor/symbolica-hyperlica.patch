+//! Reproduce the existing isolate test's interval-endpoint expectation mismatch.
+//! This is not evidence of an incorrect root: refinement still agrees.
+use symbolica::prelude::*;
+
+fn main() {
+    let polynomial = parse!("-13559717115*x^6+624134407779*x^7+-13046815434285*x^8+163110612017313*x^9+-1347733455544188*x^10+7635969738026784*x^11+-29444295941654904*x^12+71604709665043392*x^13+-77045857071990336*x^14+-99619711608972096*x^15+375578692434494208*x^16+66256662107418624*x^17+-1548072112541055488*x^18+800263217632600064*x^19+4816054475648851968*x^20+-4271696436901249024*x^21+-12066471810013724672*x^22+10894783995791278080*x^23+28270081588804452352*x^24+-17402041731641245696*x^25+-56047633173904883712*x^26+8535267319469834240*x^27+82086860869945262080*x^28+30788799964221800448*x^29+-66898313364436418560*x^30+-66318040948916879360*x^31+44159548067414016*x^32+31084367995645984768*x^33+20957883496015069184*x^34+6860635897973440512*x^35+1254041389990150144*x^36+123004564822556672*x^37+5066549580791808*x^38")
+        .to_polynomial::<_, u32>(&Q, None)
+        .to_univariate_from_univariate(0);
+    let intervals = polynomial.isolate_real_root_intervals();
+    let initial = intervals[4].clone();
+    let refined =
+        polynomial.refine_root_interval((initial.0.clone(), initial.1.clone()), &(1, 1000).into());
+    println!("fifth initial interval: {initial:?}; refined: {refined:?}");
+    assert_eq!(refined, ((1023, 4096).into(), (2049, 8192).into()));
+    // The pre-audit and patched builds give [3/16,9/32], whereas the
+    // existing unit test asks for [15/64,9/32]. Preserve the failing check.
+    assert_eq!(initial, ((15, 64).into(), (9, 32).into(), 1));
+}
