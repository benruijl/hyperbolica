From 6e20db0336fbaa2d84df22ce6ca8ff5ac259f072 Mon Sep 17 00:00:00 2001
From: Ben Ruijl <ben@ruijl.ch>
Date: Tue, 8 Sep 2026 08:44:44 +0000
Subject: [PATCH] Avoid factoring scalar-only rational denominator bases

---
 examples/mre_factored_scalar.rs               | 15 ++++++++++
 src/domains/factorized_rational_polynomial.rs |  6 ++++
 .../constructor_tests.rs                      | 29 +++++++++++++++++++
 3 files changed, 50 insertions(+)
 create mode 100644 examples/mre_factored_scalar.rs

diff --git a/examples/mre_factored_scalar.rs b/examples/mre_factored_scalar.rs
new file mode 100644
index 0000000..6e321aa
--- /dev/null
+++ b/examples/mre_factored_scalar.rs
@@ -0,0 +1,15 @@
+//! Scalar-only factored Q-to-Z construction must not factor a zero-variable polynomial.
+use symbolica::domains::factorized_rational_polynomial::FromNumeratorAndFactorizedDenominator;
+use symbolica::prelude::*;
+
+fn main() {
+    println!("Constructing factored rational 1/2, with no variables or supplied denominators");
+    let numerator = parse!("1/2").to_polynomial::<_, u16>(&Q, None);
+    let value = FactorizedRationalPolynomial::from_num_den(numerator, vec![], &Z, true);
+    assert_eq!(value.numerator.nvars(), 0);
+    assert!(value.numerator.is_one());
+    assert!(value.denominators.is_empty());
+    assert_eq!(value.numer_coeff, Integer::from(1));
+    assert_eq!(value.denom_coeff, Integer::from(2));
+    println!("PASS: exact scalar value 1/2");
+}
diff --git a/src/domains/factorized_rational_polynomial.rs b/src/domains/factorized_rational_polynomial.rs
index cba441f..fe74f30 100644
--- a/src/domains/factorized_rational_polynomial.rs
+++ b/src/domains/factorized_rational_polynomial.rs
@@ -425,6 +425,12 @@ fn prepare_denominators<R: EuclideanDomain + PolynomialGCD<E>, E: PositiveExpone
     }
     let mut remaining = Vec::new();
     for (d, power) in std::mem::take(dens) {
+        // Scalar powers are normalized by the domain-specific constructor.
+        // Avoid polynomial factorization, including its zero-variable case.
+        if d.is_constant() {
+            remaining.push((d, power));
+            continue;
+        }
         for (base, multiplicity) in d.factor() {
             let mut power = power
                 .checked_mul(multiplicity)
diff --git a/src/domains/factorized_rational_polynomial/constructor_tests.rs b/src/domains/factorized_rational_polynomial/constructor_tests.rs
index e3c22d7..5fbf02a 100644
--- a/src/domains/factorized_rational_polynomial/constructor_tests.rs
+++ b/src/domains/factorized_rational_polynomial/constructor_tests.rs
@@ -362,3 +362,32 @@ fn factored_exponent_multiplication_is_checked() {
     let _ =
         FactorizedRationalPolynomial::from_num_den(base.one(), vec![(base, usize::MAX)], &Z, true);
 }
+
+#[test]
+fn scalar_only_rational_construction_never_factors_zero_variable_polynomials() {
+    for numerator in ["1/2", "-2/3", "0"] {
+        let numerator = parse!(numerator).to_polynomial::<_, u16>(&Q, None);
+        assert_eq!(numerator.nvars(), 0);
+        for factors in [vec![], vec![("3/5", 3)], vec![("-2/3", 2)]] {
+            let factors = factors
+                .into_iter()
+                .map(|(base, power)| (parse!(base).to_polynomial(&Q, None), power))
+                .collect::<Vec<_>>();
+            let denominator = factors.iter().fold(numerator.one(), |acc, (base, power)| {
+                acc * &base.pow(*power)
+            });
+            let expected =
+                RationalPolynomial::from_num_den(numerator.clone(), denominator, &Z, true);
+            for do_factor in [false, true] {
+                let actual = FactorizedRationalPolynomial::from_num_den(
+                    numerator.clone(),
+                    factors.clone(),
+                    &Z,
+                    do_factor,
+                );
+                assert_eq!(actual.numerator.nvars(), 0);
+                assert_eq!(materialize(actual), expected);
+            }
+        }
+    }
+}
